# Secrets and local state must never enter the image.
.env
.env.local
scripts/deploy.env
agent/.venv/
agent/cases/
**/__pycache__/
data/raw/
testing/recordings/
# web/ is NOT excluded: web/Dockerfile builds from this same root context.
# Only its build artefacts are.
web/node_modules/
web/.next/
web/tsconfig.tsbuildinfo
*.md
.git/
