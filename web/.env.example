# Enviroment variables needed to connect to the LiveKit server.
LIVEKIT_API_KEY=<your_api_key>
LIVEKIT_API_SECRET=<your_api_secret>
LIVEKIT_URL=wss://<project-subdomain>.livekit.cloud

# Agent dispatch (https://docs.livekit.io/agents/server/agent-dispatch)
# Leave AGENT_NAME blank to enable automatic dispatch
# Provide an agent name to enable explicit dispatch
AGENT_NAME=

# Case API base, read on the server only so the API stays off the public
# internet. /counsellor renders its rows from this; browser-local sessions are
# merged in and shown on their own when it is unreachable.
DISHA_API_URL=

# Basic auth for /counsellor. middleware.ts fails closed — with the password
# unset the route answers 503 rather than exposing phones and wellbeing quotes.
DISHA_COUNSELLOR_USER=counsellor
DISHA_COUNSELLOR_PASSWORD=

# Optional: same case API exposed to the browser. Leave blank in any
# deployment where the API is not meant to be publicly reachable.
NEXT_PUBLIC_DISHA_API=

# Internally used environment variables
NEXT_PUBLIC_APP_CONFIG_ENDPOINT=
SANDBOX_ID=
